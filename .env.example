# ============================================================
# Cafezeira / Whitelabel — Variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env real no Git.
# ============================================================

# ----- Supabase (obrigatório - frontend) -----
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=SEU_PROJECT_REF

# ----- Supabase (obrigatório - SSR / server-side) -----
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...

# ----- Supabase Service Role (Edge Functions - NUNCA expor no frontend) -----
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# WHITELABEL — Identidade visual do tenant
# ============================================================
# Se não definidas, os padrões "Café EX" são usados.

# Nome da plataforma/loja (aparece no header, footer, títulos de página)
VITE_TENANT_NAME=Café EX

# Slogan exibido no footer e meta description
VITE_STORE_TAGLINE=Cafés especiais com origem e curadoria

# URL da logo (PNG/SVG). Se vazio, usa a logo padrão do projeto.
# VITE_LOGO_URL=https://cdn.suatorra.com/logo.png

# Cor primária em qualquer formato CSS válido (hex, oklch, hsl...).
# Sobrescreve a variável CSS --primary em todo o site.
# VITE_PRIMARY_COLOR=#5c3317

# URL base da loja (usada em links de e-mail / webhooks)
# VITE_STORE_URL=https://suatorra.com

# E-mail de suporte ao cliente
# VITE_SUPPORT_EMAIL=contato@suatorra.com

# Handle do Instagram (sem @)
# VITE_INSTAGRAM=suatorra

# Nome do clube de assinatura
# VITE_CLUB_NAME=Clube da Torra

# ============================================================
# PAGAMENTOS — configurados no painel /admin/integracoes
# (salvo criptografado em tenant_credentials no Supabase)
# NÃO use variáveis de ambiente para as chaves de produção do MP/ME
# ============================================================
# MERCADO_PAGO_ACCESS_TOKEN=  ← gerenciado via /admin/integracoes
# MELHOR_ENVIO_TOKEN=          ← gerenciado via /admin/integracoes

# ============================================================
# WEBHOOKS (Edge Functions — configure no painel Supabase)
# ============================================================
# MP_WEBHOOK_SECRET=  ← secret HMAC configurado no MP Dashboard
