# ============================================================
# Cafezeira — Variáveis de ambiente
# ============================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env real no Git.
# ============================================================

# ----- Supabase (obrigatório - frontend) -----
# Encontre em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PROJECT_ID=pmqexsfsccwswdjpknlu

# ----- Supabase (obrigatório - SSR / server-side) -----
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...

# ----- Supabase Service Role (sensível - apenas Edge Functions e scripts admin) -----
# NUNCA prefixar com VITE_, NUNCA expor no frontend.
# Encontre em: https://supabase.com/dashboard/project/_/settings/api (seção "service_role")
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----- Pagamento (a definir com sócio - onda 6) -----
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ----- Frete (futuro) -----
# MELHOR_ENVIO_TOKEN=
